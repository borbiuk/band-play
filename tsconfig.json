{
	"compilerOptions": {
		"strict": false,
		"strictNullChecks": false,
		"target": "ES2021",
		"lib": ["ES2021", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"module": "ESNext",
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"types": ["chrome"],
		"paths": {
			"@shared/*": ["./src/shared/*"]
		}
	},
	"include": ["src"]
}
