{
	"name": "bandcamp-play",
	"version": "10.3.0",
	"description": "Enhanced playback for Bandcamp: autoplay, speed, pitch, hotkeys, history, batch download, and more.",
	"private": true,
	"author": "Nazarii Borbiuk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/borbiuk/band-play"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"watch": "webpack --config webpack/webpack.dev.js --watch",
		"build": "webpack --config webpack/webpack.prod.js",
		"build:firefox": "webpack --config webpack/webpack.firefox.js",
		"analyze": "webpack --config webpack/webpack.analyze.js",
		"clean": "rimraf dist dist-firefox",
		"zip": "./zip.sh",
		"typecheck": "node node_modules/typescript7/bin/tsc --noEmit && node node_modules/typescript7/bin/tsc --noEmit -p tests",
		"lint": "eslint . && npm run typecheck",
		"lint:fix": "eslint --fix .",
		"lint:firefox": "web-ext lint --source-dir dist-firefox",
		"test": "playwright test --project=unit --project=e2e",
		"test:unit": "playwright test --project=unit",
		"test:e2e": "playwright test --project=e2e",
		"test:live": "BAND_PLAY_LIVE=1 playwright test --project=live",
		"test:snapshots": "node tests/e2e/fixtures/capture-pages.mjs",
		"format": "prettier --write \"./**/*.{ts,tsx,js,mjs,json,md,yml,scss,css,html}\" --config ./.prettierrc.json",
		"format:check": "prettier --check \"./**/*.{ts,tsx,js,mjs,json,md,yml,scss,css,html}\" --config ./.prettierrc.json",
		"check:versions": "node scripts/check-versions.mjs",
		"check:outdated": "npm outdated",
		"prepare": "husky"
	},
	"dependencies": {
		"lucide-react": "1.61.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-tooltip": "6.0.9"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@types/chrome": "0.3.6",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"autoprefixer": "10.6.1",
		"chrome-webstore-upload-cli": "4.0.2",
		"copy-webpack-plugin": "14.0.0",
		"css-loader": "7.1.5",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-playwright": "2.12.1",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.13.0",
		"husky": "9.1.7",
		"postcss": "8.5.31",
		"postcss-loader": "8.2.1",
		"postcss-preset-env": "11.6.1",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"rimraf": "6.1.3",
		"sass": "1.106.1",
		"sass-loader": "17.0.1",
		"style-loader": "4.0.0",
		"tailwindcss": "3.4.17",
		"terser-webpack-plugin": "5.6.1",
		"ts-loader": "9.6.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"typescript7": "npm:typescript@7.0.2",
		"web-ext": "10.8.0",
		"webpack": "5.112.2",
		"webpack-bundle-analyzer": "5.4.0",
		"webpack-cli": "7.2.3",
		"webpack-merge": "6.0.1"
	},
	"overrides": {
		"eslint-plugin-react": {
			"eslint": "$eslint"
		},
		"postcss-selector-parser": "7.1.7"
	}
}
